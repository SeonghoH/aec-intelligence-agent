# Optional future API keys. The MVP does not require these.
CROSSREF_MAILTO=
ARXIV_MAX_RESULTS=10

# Notion setup (only needed to run scripts/setup_notion_databases.py).
# NOTION_TOKEN: secret from your Notion integration.
# NOTION_PARENT_PAGE_ID: the page where the two databases will be created.
# The DB IDs below are filled in by you after running the setup script.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DAILY_DB_ID=
NOTION_RESEARCH_DB_ID=

# LLM summarization (optional). Leave LLM_ENABLED=false to disable entirely.
# Currently only `gemini` is wired up. Get a free API key at
# https://aistudio.google.com (Get API key -> Create API key).
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-pro
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_MAX_ITEMS=1
LLM_MIN_SCORE=80
LLM_MAX_CHARS=40000

# Unpaywall — free DOI → open-access PDF discovery.
# An email is required by the Unpaywall API so they can contact heavy users.
# Use your real address (it is NOT used for marketing).
UNPAYWALL_EMAIL=you@example.com
